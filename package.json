{
  "name": "pi-lab",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "bun run build && node node_modules/@playwright/test/cli.js test",
    "verify": "bun run scripts/verify.ts",
    "package": "bun run --cwd apps/desktop package",
    "package:stable": "bun run --cwd apps/desktop package:stable",
    "package:stable:keep": "bun run --cwd apps/desktop package:stable:keep",
    "package:public": "bun run --cwd apps/desktop package:public",
    "link:apps": "bun run --cwd apps/desktop link:apps",
    "package:prod": "bun run --cwd apps/desktop package:prod",
    "package:prod:stable": "bun run --cwd apps/desktop package:prod:stable",
    "clean": "rm -rf node_modules"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "electron",
    "node-pty"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@playwright/test": "^1.49.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.0.0",
    "fast-check": "^4.8.0",
    "jsdom": "^25.0.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
