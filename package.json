{
  "name": "pi-lab",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "docs:dev": "vitepress dev md --host=127.0.0.1",
    "docs:build": "vitepress build md && bun scripts/docs-export.ts",
    "docs:preview": "bun run docs:build && bun scripts/docs-preview.ts",
    "docs:test": "bun run docs:build && node node_modules/@playwright/test/cli.js test e2e/docs-offline.spec.ts",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun run --cwd apps/desktop restore:native:node && vitest run",
    "test:watch": "bun run --cwd apps/desktop restore:native:node && vitest",
    "e2e": "bun run build && bun run docs:build && node node_modules/@playwright/test/cli.js test",
    "verify": "bun run scripts/verify.ts",
    "package": "bun run --cwd apps/desktop package",
    "package:prod": "bun run --cwd apps/desktop package:prod",
    "clean": "rm -rf node_modules"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "electron",
    "node-pty"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@playwright/test": "^1.49.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.0.0",
    "fast-check": "^4.8.0",
    "jsdom": "^25.0.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "vitepress": "1.6.4",
    "vitest": "^4.0.0"
  }
}
