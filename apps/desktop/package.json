{
  "name": "@pi-lab/desktop",
  "version": "0.0.0",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "bun run rebuild:native:electron && electron-vite dev",
    "build": "electron-vite build",
    "build:icons": "bun scripts/generate-app-icon.ts",
    "setup:native": "node scripts/setup-native.cjs",
    "rebuild:native:electron": "node scripts/rebuild-native-electron.cjs",
    "restore:native:node": "node scripts/restore-native-node.cjs",
    "validate:native": "node scripts/run-validate-native.cjs",
    "package": "bun run build:icons && electron-vite build && bun run setup:native && bun run rebuild:native:electron && bun run validate:native && electron-builder --config electron-builder.config.cjs --dir",
    "package:prod": "bun run build:icons && electron-vite build && bun run setup:native && bun run rebuild:native:electron && bun run validate:native && electron-builder --config electron-builder.config.cjs",
    "preview": "bun run rebuild:native:electron && electron-vite preview",
    "start": "bun run rebuild:native:electron && electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.2",
    "@lezer/highlight": "^1.2.3",
    "@pi-lab/local-db": "workspace:*",
    "@pi-lab/port-scanner": "workspace:*",
    "@pi-lab/pty-daemon": "workspace:*",
    "@pi-lab/shared": "workspace:*",
    "@pi-lab/ui": "workspace:*",
    "@pi-lab/workspace-fs": "workspace:*",
    "@replit/codemirror-vim": "^6.3.0",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-router": "^1.168.8",
    "@trpc/client": "^11",
    "@trpc/server": "^11",
    "@trpc/tanstack-react-query": "^11.18.0",
    "@uiw/codemirror-themes": "^4.25.10",
    "@xterm/addon-fit": "^0.10",
    "@xterm/headless": "5.5.0",
    "@xterm/xterm": "^5",
    "better-sqlite3": "^13.0.1",
    "codemirror": "^6.0.2",
    "drizzle-orm": "^0.45.0",
    "lucide-react": "^0.563.0",
    "node-pty": "^1.1.0",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^9.0.1",
    "recharts": "2.15.4",
    "remark-gfm": "^4.0.0",
    "superjson": "^2.2.6",
    "trpc-electron": "^0.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/router-plugin": "^1.167.9",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4",
    "electron": "^40",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.2.2",
    "vite": "^7"
  }
}
