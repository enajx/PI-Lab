{
  "name": "@pi-lab/desktop",
  "version": "0.0.0",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "bun run prepare:latex && electron-vite dev",
    "build": "bun run prepare:latex && electron-vite build",
    "build:icons": "bun scripts/generate-app-icon.ts",
    "setup:native": "node scripts/setup-native.cjs && bun run validate:native:node",
    "validate:native:node": "node scripts/validate-native.cjs",
    "validate:native": "node scripts/run-validate-native.cjs",
    "validate:package": "node scripts/validate-package-dependencies.cjs",
    "validate:package-output": "node scripts/assert-package-output-idle.cjs",
    "link:apps": "node scripts/install-applications.cjs",
    "package": "node scripts/package-channel.cjs alpha",
    "package:stable": "node scripts/test-stable-package.cjs",
    "package:stable:keep": "node scripts/package-channel.cjs stable",
    "package:public": "node scripts/package-public-release.cjs",
    "package:prod": "node scripts/package-channel.cjs alpha prod",
    "package:prod:stable": "node scripts/package-channel.cjs stable prod",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "prepare:latex": "node scripts/prepare-latex-runtime.cjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.2",
    "@jsquash/webp": "^1.5.0",
    "@lezer/highlight": "^1.2.3",
    "@pi-lab/local-db": "workspace:*",
    "@pi-lab/port-scanner": "workspace:*",
    "@pi-lab/pty-daemon": "workspace:*",
    "@pi-lab/shared": "workspace:*",
    "@pi-lab/ui": "workspace:*",
    "@pi-lab/workspace-fs": "workspace:*",
    "@replit/codemirror-vim": "^6.3.0",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-router": "^1.168.8",
    "@trpc/client": "^11",
    "@trpc/server": "^11",
    "@trpc/tanstack-react-query": "^11.18.0",
    "@uiw/codemirror-themes": "^4.25.10",
    "@xterm/addon-fit": "^0.10",
    "@xterm/headless": "5.5.0",
    "@xterm/xterm": "^5",
    "better-sqlite3": "^13.0.1",
    "codemirror": "^6.0.2",
    "dockview": "8.5.1",
    "dockview-core": "8.5.1",
    "dockview-react": "8.5.1",
    "drizzle-orm": "^0.45.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.563.0",
    "node-pty": "^1.1.0",
    "omggif": "^1.0.10",
    "pdfjs-dist": "6.4.299",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^9.0.1",
    "recharts": "2.15.4",
    "remark-gfm": "^4.0.0",
    "superjson": "^2.2.6",
    "trpc-electron": "^0.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/router-plugin": "^1.167.9",
    "@types/better-sqlite3": "^7.6.13",
    "@types/omggif": "^1.0.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4",
    "electron": "^40",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.2.2",
    "vite": "^7"
  }
}
