mise.toml

# Codex workspace config (track only shared config/symlinks; ignore runtime state)
.codex/*
!.codex/config.toml
!.codex/commands
!.codex/prompts
.amp/*

# MCP config (contains per-user server URLs/tokens)
.mcp.json
.cursor/mcp.json

# Local-only plans / reference research projects (not PI Lab source)
plans/local/
project_examples/

# Desktop packaging — app icons are generated from icons/icon.png at build time
# (release/ output is covered by the `release` rule above; entitlements plist IS tracked)
apps/desktop/build/icon.png
apps/desktop/build/icon.icns
apps/desktop/build/icon.ico
