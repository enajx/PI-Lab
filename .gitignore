yarn.lock

# Test / e2e output
/test-results/
/playwright-report/
/playwright/.cache/
coverage

# Env / secrets
.env
.env.*
.envrc
.env.local
!.bun-version

# Local project notes linked from PI-Lab-private
/AGENTS.md
/CLAUDE.md
/PROJECT.md
/TODO.md
/md/

# Tooling caches
.turbo
.cache
.tmp/
__pycache__/
*.pyc
